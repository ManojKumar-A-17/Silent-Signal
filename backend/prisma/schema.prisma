generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookmarks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal_id  String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  signals    signals   @relation(fields: [signal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([signal_id, user_id])
}

model comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal_id  String    @db.Uuid
  user_id    String    @db.Uuid
  content    String
  is_edited  Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  signals    signals   @relation(fields: [signal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  flags      flags[]

  @@index([signal_id], map: "idx_comments_signal_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model flags {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal_id  String?   @db.Uuid
  comment_id String?   @db.Uuid
  user_id    String    @db.Uuid
  flag_type  String    @db.VarChar(30)
  status     String?   @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  comments   comments? @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  signals    signals?  @relation(fields: [signal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model likes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal_id  String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  signals    signals   @relation(fields: [signal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([signal_id, user_id])
  @@index([signal_id], map: "idx_likes_signal_id")
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String
  expires_at DateTime  @db.Timestamp(6)
  is_revoked Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reshares {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  original_signal_id String    @db.Uuid
  user_id            String    @db.Uuid
  reshare_text       String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  signals            signals   @relation(fields: [original_signal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([original_signal_id, user_id])
  @@index([original_signal_id], map: "idx_reshares_signal_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model signals {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String      @db.Uuid
  content          String
  stress_type      String?     @db.VarChar(20)
  stress_intensity Int?
  ai_confidence    Float?
  ai_reflection    String?
  is_published     Boolean?    @default(false)
  is_flagged       Boolean?    @default(false)
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  updated_at       DateTime?   @default(now()) @db.Timestamp(6)
  bookmarks        bookmarks[]
  comments         comments[]
  flags            flags[]
  likes            likes[]
  reshares         reshares[]
  users            users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_signals_created_at")
  @@index([stress_type], map: "idx_signals_stress_type")
}

model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?          @unique @db.VarChar(255)
  password_hash  String?
  role           String?          @default("user") @db.VarChar(20)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?        @db.Timestamp(6)
  bookmarks      bookmarks[]
  comments       comments[]
  flags          flags[]
  likes          likes[]
  refresh_tokens refresh_tokens[]
  reshares       reshares[]
  signals        signals[]
}
